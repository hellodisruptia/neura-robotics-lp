---
import { storyblokEditable } from "@storyblok/astro";

const { blok } = Astro.props;

/* ---------- Lien du bouton (champ Link de Storyblok) ---------- */
const link = blok.button_link;
let href = "";
if (link?.linktype === "story") href = `/${link.cached_url ?? ""}`;
else if (link?.linktype === "email" && link.email) href = `mailto:${link.email}`;
else href = link?.url || link?.cached_url || "";

const isExternal = /^https?:\/\//.test(href);

/* ---------- Média : image ou vidéo ---------- */
const media = blok.image; // champ "image" (Any filetype)
const file: string = media?.filename ?? "";
const alt: string = media?.alt ?? "";

const isVideo = /\.(mp4|webm|mov)$/i.test(file);
const isResizable = /\.(jpe?g|png|webp)$/i.test(file); // SVG/GIF : pas de redimensionnement

// Storyblok met les dimensions dans l'URL : /f/123/1920x1080/abc/photo.jpg
const dims = file.match(/\/(\d+)x(\d+)\//);
const width = dims ? Number(dims[1]) : 1920;
const height = dims ? Number(dims[2]) : 1080;

// Service d'images Storyblok : largeur voulue, hauteur auto, WebP
const resize = (w: number) => `${file}/m/${w}x0/filters:format(webp)`;
const widths = [640, 1024, 1600, 2400].filter((w) => w < width).concat(width);

const imgSrc = isResizable ? resize(Math.min(1600, width)) : file;
const imgSrcset = isResizable
  ? widths.map((w) => `${resize(w)} ${w}w`).join(", ")
  : undefined;
---

<section class="hero" data-hero {...storyblokEditable(blok)}>
  {file && isVideo && (
    <video
      class="hero__media"
      src={file}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={alt || undefined}
      aria-hidden={alt ? undefined : "true"}
    />
  )}

  {file && !isVideo && (
    <img
      class="hero__media"
      src={imgSrc}
      srcset={imgSrcset}
      sizes="100vw"
      alt={alt}
      width={width}
      height={height}
      fetchpriority="high"
      decoding="async"
    />
  )}

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="hero__content">
    <h1 class="hero__title">{blok.title}</h1>

    {blok.subtitle && <p class="hero__subtitle">{blok.subtitle}</p>}

    {blok.button_label && href && (
      <a
        class="hero__button"
        href={href}
        {...(isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      >
        {blok.button_label}
        <span aria-hidden="true">→</span>
      </a>
    )}
  </div>

  {isVideo && (
    <button class="hero__toggle" type="button" data-hero-toggle>
      <span aria-hidden="true" data-hero-icon>❚❚</span>
      <span class="visually-hidden" data-hero-label>Pause video</span>
    </button>
  )}
</section>

<script>
  // Bouton pause/lecture (WCAG 2.2.2) + respect de « réduire les animations »
  const labels = {
    en: { pause: "Pause video", play: "Play video" },
    fr: { pause: "Mettre la vidéo en pause", play: "Lire la vidéo" },
  };
  const lang = document.documentElement.lang as keyof typeof labels;
  const t = labels[lang] ?? labels.en;

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-hero]").forEach((hero) => {
    const video = hero.querySelector("video");
    const button = hero.querySelector<HTMLButtonElement>("[data-hero-toggle]");
    const icon = hero.querySelector<HTMLElement>("[data-hero-icon]");
    const label = hero.querySelector<HTMLElement>("[data-hero-label]");
    if (!video || !button || !icon || !label) return;

    const update = () => {
      icon.textContent = video.paused ? "▶" : "❚❚";
      label.textContent = video.paused ? t.play : t.pause;
    };

    if (reduceMotion) video.pause();

    button.addEventListener("click", () => {
      if (video.paused) video.play();
      else video.pause();
    });
    video.addEventListener("play", update);
    video.addEventListener("pause", update);
    update();
  });
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: var(--hero-min-height);
    padding-block: var(--space-2xl) var(--space-xl);
    padding-inline: var(--gutter);
    overflow: hidden;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: var(--z-behind);
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: var(--z-below);
    background: var(--gradient-hero-overlay);
  }

  .hero__content {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .hero__title {
    max-width: 18ch;
    font-size: var(--text-3xl);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-heading);
  }

  .hero__subtitle {
    max-width: var(--measure);
    margin-block-start: var(--space-sm);
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-target);
    margin-block-start: var(--space-md);
    padding-inline: var(--space-md);
    border: var(--border-width) solid var(--color-glass-border);
    border-radius: var(--radius-pill);
    background: var(--color-glass);
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: background var(--transition);
  }

  .hero__button:hover {
    background: var(--color-glass-hover);
  }

  .hero__toggle {
    position: absolute;
    right: var(--gutter);
    bottom: var(--space-md);
    display: grid;
    place-items: center;
    width: var(--tap-target);
    height: var(--tap-target);
    border: var(--border-width) solid var(--color-glass-border);
    border-radius: var(--radius-pill);
    background: var(--color-glass);
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
    color: var(--color-text);
    font-size: var(--text-xs);
    cursor: pointer;
    transition: background var(--transition);
  }

  .hero__toggle:hover {
    background: var(--color-glass-hover);
  }
</style>