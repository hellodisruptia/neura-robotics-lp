---
import "@fontsource-variable/inter";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
}

const {
  title = "NEURA Robotics",
  description = "Cognitive robots by NEURA Robotics.",
  lang = "en",
} = Astro.props;

// Textes de l'interface (hors Storyblok)
const ui = {
  en: { skip: "Skip to content" },
  fr: { skip: "Aller au contenu" },
};
const t = ui[lang as keyof typeof ui] ?? ui.en;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="https://a.storyblok.com/f/296220697403452/32x32/0d8f4ddbd4/favicon-32x32.webp" />
    <link rel="icon" href="https://a.storyblok.com/f/296220697403452/32x32/0d8f4ddbd4/favicon-32x32.webp" sizes="32x32" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <slot />
  </body>
</html>